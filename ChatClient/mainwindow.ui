  <property name="styleSheet">
   <string notr="true">#titleLabel{
    /* 背景：浅蓝渐变+轻微透明度，比纯白更有层次感 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0f8ff, stop:1 #e8f4f8);
    /* 文字：深蓝色（比纯蓝更柔和），避免刺眼 */
    color: #2c5aa0;
    border: none;
    /* 字体：微软雅黑+加粗+22px，清晰易读 */
    font-family: &quot;Microsoft YaHei&quot;, &quot;SimHei&quot;, Arial;
    font-size: 22px;
    font-weight: 600; /* 半加粗，比bold更自然 */
    /* 底部边框：浅灰色细边框，比纯黑更柔和，增加圆角过渡 */
    border-bottom: 1px solid #d0d7e0;
    /* 内边距：上下8px，左右5px，文字垂直居中更舒适 */
    padding: 8px 5px;
    /* 可选：文字左对齐（默认），如需居中加 text-align: center; */
    text-align: left;
}
#mainFrame{
border:none;
background:white;
}
#loginFrame{
background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #2e7d32,stop:1 #a5d6a7);
border:1px solid gray;
padding:10px;
border-radius:25px;
}</string>
